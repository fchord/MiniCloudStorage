# MiniCloudStorage — 环境变量示例
# 用法：复制为 .env 后按需修改。真实 .env 已被 gitignore，勿提交密钥。
# 生产（K8s）敏感项见 README「配置」：Secret postgres / admin。

# ---- 必填 ----
# Postgres 连接串（示例假值，请改成你的）
DATABASE_URL=postgres://minicloudstorage:CHANGE_ME@192.168.43.111:5432/minicloudstorage?sslmode=disable

# ---- 可选：管理端 ----
# 未设置时行为以代码/初始化逻辑为准；集群中来自 Secret admin
ADMIN_PASSWORD=CHANGE_ME

# ---- 可选：服务与公网 ----
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=https://minicloudstorage.19121122.xyz
STATIC_DIR=/app/static

# ---- 可选：SeaweedFS ----
SEAWEEDFS_FILER_URL=http://seaweedfs-filer.default.svc.cluster.local:8888
SEAWEEDFS_PREFIX=/minicloudstorage
SEAWEEDFS_COLLECTION=minicloudstorage
SEAWEEDFS_FILE_TTL=8d
SEAWEEDFS_TMP_TTL=2d

# ---- 可选：上传限制（字节）----
# 默认与代码一致：8MiB / 4GiB
CHUNK_SIZE=8388608
MAX_SIZE=4294967296